rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email is string
        && request.auth.token.email.matches('^[^@]+@sbgdirector[.]com$')
        && exists(/databases/$(database)/documents/administradores/$(request.auth.uid))
        && get(/databases/$(database)/documents/administradores/$(request.auth.uid)).data.activo == true;
    }

    match /administradores/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list: if isAdmin();
      allow write: if false;
    }

    match /usuariosPorUid/{uid} {
      allow get: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow list, write: if isAdmin();
    }

    match /{collection}/{document=**} {
      allow read, write: if request.auth != null
        && collection != 'administradores'
        && collection != 'usuariosPorUid';
    }

  }
}
